#include <winuser.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "bb-probe.manifest"
// The first icon is the one Explorer and the game window show.
1 ICON "../../launcher/dcport.ico"

// DCport: DRIVECLUB for Windows (Properties -> Details).
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DCport - DRIVECLUB runtime"
            VALUE "ProductName", "DCport"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductVersion", "0.1.0"
            VALUE "LegalCopyright", "GPL-2.0-or-later. Built on bbport (deadinside28, Supermedo) and shadPS4."
            VALUE "OriginalFilename", "DriveClub.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
